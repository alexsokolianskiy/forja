{
    "name": "alexsokolianskiy/forja",
    "description": "Translate hot PHP methods to C with an LLM (Claude or a local model), compile them and call them through FFI, with verified fallback to the original PHP.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-ffi": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "nikic/php-parser": "^5.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Forja\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Forja\\Tests\\": "tests/",
            "Forja\\Benchmarks\\": "benchmarks/"
        }
    },
    "bin": [
        "bin/forja"
    ],
    "scripts": {
        "test": "phpunit",
        "bench": "@php benchmarks/run.php"
    }
}
