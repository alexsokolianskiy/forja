#!/usr/bin/env php
<?php

declare(strict_types=1);

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

try {
    exit((new AiAccel\Console\CompileCommand())->run(array_slice($argv, 1)));
} catch (Throwable $e) {
    fwrite(STDERR, 'ai-c-compile: ' . $e->getMessage() . "\n");
    exit(2);
}
